# ============================================================
# CYBER-DECK .gitignore
# Protege dados pessoais, binários e arquivos sensíveis
# ============================================================


# ------------------------------------------------------------
# DADOS PESSOAIS E BACKUPS (nunca commitar)
# ------------------------------------------------------------

# Pasta principal de backups datados (contém chaves BitLocker!)
DADOS/

# Chaves de recuperação BitLocker onde quer que estejam
CHAVES_RECUPERACAO_BITLOCKER/
*BITLOCKER*.txt
*RECOVERY_KEY*
*.key
*.bek

# Backups de registro (.reg gerados automaticamente)
BACKUP_LIMPEZA_REGISTRO_ORFAOS/
RELATORIOS_LIMPEZA_REGISTRO/
RELATORIOS_HARDWARE/
BACKUPS-PROGRAMAS/
BACKUP DADOS NAVEGADORES/

# Exportação de programas instalados
meus_programas.json
*_programas.json

# Relatórios de bateria e hardware
*.html


# ------------------------------------------------------------
# FERRAMENTAS PORTÁTEIS BAIXADAS AUTOMATICAMENTE
# (binários e pastas de ferramentas não devem subir ao repositório)
# ------------------------------------------------------------

# ADB Android completo
ADB ANDROID/
[Aa][Dd][Bb]*[Aa][Nn][Dd][Rr][Oo][Ii][Dd]/

# libimobiledevice iPhone completo
LIBIMOBILEDEVICE IPHONE/
[Ll][Ii][Bb][Ii][Mm][Oo][Bb][Ii][Ll][Ee][Dd][Ee][Vv][Ii][Cc][Ee]*[Ii][Pp][Hh][Oo][Nn][Ee]/

# Programas de Backup portáteis (PhotoRec, TestDisk, etc.)
PROGRAMAS BACKUP/
[Pp][Rr][Oo][Gg][Rr][Aa][Mm][Aa][Ss]*[Bb][Aa][Cc][Kk][Uu][Pp]/

# VeraCrypt portátil
VERACRYPT PORTATIL/*.exe
VERACRYPT PORTATIL/*.dll
VERACRYPT PORTATIL/*.sys

# Arquivos ZIP de download temporário
*.zip
*.tar.gz
*.7z


# ------------------------------------------------------------
# ARQUIVOS TEMPORÁRIOS DO WINDOWS
# ------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# Arquivos temporários gerais
*.tmp
*.temp
~$*


# ------------------------------------------------------------
# LOGS E DEPURAÇÃO
# ------------------------------------------------------------
*.log
*.log.*
logs/
*.bak
*.txt.bak
*.old


# ------------------------------------------------------------
# SENHAS E DADOS SENSÍVEIS
# ------------------------------------------------------------
*senha*
*password*
*senhas*
*credentials*
*secrets*
*.csv


# ------------------------------------------------------------
# EDITORES E IDEs
# ------------------------------------------------------------

# VS Code
.vscode/

# JetBrains
.idea/
*.iml

# Notepad++
nppBackup/

# PowerShell ISE
*.ps1xml


# ------------------------------------------------------------
# SISTEMA OPERACIONAL
# ------------------------------------------------------------

# Windows
[Dd]esktop.ini
[Tt]humbs.db
*.stackdump

# macOS (caso alguém abra o projeto num Mac)
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
